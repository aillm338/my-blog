---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((cat) => ({
    params: { slug: cat },
  }));
}

const { slug } = Astro.params;
const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.data.category === slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base>
  <a
    href={import.meta.env.BASE_URL}
    class="inline-flex items-center gap-1 text-sm text-zinc-500 hover:text-zinc-200 transition-colors mb-10 group"
  >
    <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
    返回首页
  </a>

  <section class="mb-12 animate-fade-in">
    <h1 class="text-3xl font-bold tracking-tight mb-2">
      <span class="gradient-text">{slug}</span>
    </h1>
    <p class="text-zinc-500 text-sm">{posts.length} 篇文章</p>
  </section>

  {
    posts.length > 0 ? (
      <div class="space-y-4">
        {posts.map((post, i) => (
          <a
            href={`${import.meta.env.BASE_URL}blog/${post.id.replace(/\.md$/, "")}/`}
            class="glass card-hover rounded-2xl p-6 block group"
            style={`animation: fadeUp 0.5s ease-out ${i * 0.08}s both`}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="text-lg font-semibold text-zinc-100 group-hover:text-purple-300 transition-colors mb-2">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-zinc-500 text-sm leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                )}
              </div>
              <time class="text-xs text-zinc-600 whitespace-nowrap mt-0.5 shrink-0 font-mono" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}
              </time>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="glass rounded-2xl p-12 text-center animate-fade-in">
        <p class="text-zinc-500">这个分类下还没有文章。</p>
      </div>
    )
  }
</Base>
