---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base>
  <!-- Hero -->
  <section class="mb-16 animate-fade-in">
    <h1 class="text-4xl font-bold tracking-tight mb-4">
      <span class="gradient-text">关于网站</span>
    </h1>
    <p class="text-zinc-500 text-lg leading-relaxed max-w-lg">
      记录学习思考与生活随想。
    </p>
  </section>

  <!-- Post Cards -->
  <div class="space-y-4">
    {
      posts.map((post, i) => (
        <a
          href={`${import.meta.env.BASE_URL}blog/${post.id.replace(/\.md$/, "")}/`}
          class="glass card-hover rounded-2xl p-6 block group"
          style={`animation: fadeUp 0.5s ease-out ${i * 0.08}s both`}
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-zinc-100 group-hover:text-purple-300 transition-colors mb-2">
                {post.data.title}
              </h2>
              {
                post.data.description && (
                  <p class="text-zinc-500 text-sm leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                )
              }
            </div>
            <time
              class="text-xs text-zinc-600 whitespace-nowrap mt-0.5 shrink-0 font-mono"
              datetime={post.data.date.toISOString()}
            >
              {post.data.date.toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
              })}
            </time>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <span class="text-xs text-zinc-600 group-hover:text-purple-400 transition-colors">
              阅读更多 &rarr;
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Empty state -->
  {
    posts.length === 0 && (
      <div class="glass rounded-2xl p-12 text-center animate-fade-in">
        <p class="text-zinc-500">还没有文章，开始写第一篇吧。</p>
      </div>
    )
  }
</Base>
