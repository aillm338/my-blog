---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const categories = [...new Set(posts.map((p) => p.data.category))];

const categoryInfo: Record<string, { desc: string }> = {
  "记录我的学习生活": { desc: "技术笔记、编程心得与工具分享" },
  "生活随笔": { desc: "我将在这里记录生活中有趣的事情和我的感想" },
};

const totalPosts = posts.length;
---

<Base>
  <!-- Hero -->
  <section class="mb-14 animate-fade-in">
    <h1 class="text-4xl font-bold tracking-tight mb-4">
      <span class="gradient-text">关于网站</span>
    </h1>
    <p class="text-zinc-500 text-lg leading-relaxed max-w-lg">
      记录学习思考与生活随想。
    </p>
  </section>

  <!-- Category Cards -->
  <section class="mb-14 animate-fade-in" style="animation-delay: 0.1s">
    <h2 class="text-sm font-medium text-zinc-600 uppercase tracking-wider mb-4">分类浏览</h2>
    <div class="space-y-4">
      {
        categories.map((cat) => {
          const count = posts.filter((p) => p.data.category === cat).length;
          const info = categoryInfo[cat] || { desc: "" };
          return (
            <a
              href={`${import.meta.env.BASE_URL}category/${cat}/`}
              class="glass card-hover rounded-2xl p-6 block group"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <h3 class="text-xl font-semibold text-zinc-100 group-hover:text-purple-300 transition-colors mb-2">
                    {cat}
                  </h3>
                  <p class="text-sm text-zinc-500 leading-relaxed">
                    {info.desc}
                  </p>
                </div>
                <div class="text-right shrink-0">
                  <p class="text-2xl font-bold gradient-text">{count}</p>
                  <p class="text-xs text-zinc-600 mt-1">篇文章</p>
                </div>
              </div>
              <div class="mt-4 flex items-center gap-2">
                <span class="text-xs text-zinc-600 group-hover:text-purple-400 transition-colors">
                  浏览全部 &rarr;
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="animate-fade-in" style="animation-delay: 0.2s">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-medium text-zinc-600 uppercase tracking-wider">最近更新</h2>
      <span class="text-xs text-zinc-600 font-mono">共 {totalPosts} 篇</span>
    </div>
    <div class="space-y-3">
      {
        posts
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
          .slice(0, 5)
          .map((post) => (
            <a
              href={`${import.meta.env.BASE_URL}blog/${post.id.replace(/\.md$/, "")}/`}
              class="glass card-hover rounded-xl px-5 py-3 flex items-center justify-between gap-3 group"
            >
              <div class="min-w-0 flex items-center gap-3">
                <span class="text-xs text-zinc-600 font-mono shrink-0">
                  {post.data.date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
                </span>
                <span class="text-sm text-zinc-300 truncate group-hover:text-purple-300 transition-colors">
                  {post.data.title}
                </span>
              </div>
              <span class="text-xs text-zinc-600 font-mono bg-zinc-800/50 px-2 py-0.5 rounded shrink-0">
                {post.data.category}
              </span>
            </a>
          ))
      }
    </div>
  </section>
</Base>
