<div id="profile-modal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <!-- Backdrop -->
  <div
    id="profile-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm"
  ></div>

  <!-- Card -->
  <div class="relative z-10 glass rounded-2xl p-8 w-full max-w-md mx-4 animate-fade-up shadow-2xl shadow-purple-900/20">
    <!-- Close button -->
    <button
      id="profile-close"
      class="absolute top-4 right-4 text-zinc-500 hover:text-zinc-200 transition-colors text-xl leading-none"
      aria-label="关闭"
    >
      &times;
    </button>

    <!-- Avatar -->
    <div class="flex justify-center mb-6">
      <img src={`${import.meta.env.BASE_URL}avatar.jpg`} alt="头像" class="w-20 h-20 rounded-full object-cover shadow-lg shadow-purple-500/30" />
    </div>

    <!-- Info -->
    <div class="text-center mb-6">
      <h2 class="text-xl font-semibold text-zinc-100 mb-1">Cheng Zhang</h2>
      <p class="text-sm text-zinc-500 font-mono">@aillm338</p>
    </div>

    <p class="text-sm text-zinc-400 leading-relaxed text-center mb-6">
      我爱我的家乡--鸡泽<br />我始终相信，真正的创新不仅在技术本身，更在于用它解决问题、创造价值，而我也希望成为那个将想法落地的人。
    </p>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="text-center">
        <div class="text-lg font-semibold gradient-text">12</div>
        <div class="text-xs text-zinc-600 mt-1">文章</div>
      </div>
      <div class="text-center">
        <div class="text-lg font-semibold gradient-text">3</div>
        <div class="text-xs text-zinc-600 mt-1">项目</div>
      </div>
      <div class="text-center">
        <div class="text-lg font-semibold gradient-text">5</div>
        <div class="text-xs text-zinc-600 mt-1">标签</div>
      </div>
    </div>

    <!-- Social links -->
    <div class="flex justify-center gap-4">
      <a
        href="https://github.com/aillm338"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-500 hover:text-purple-400 transition-colors text-sm"
      >
        GitHub
      </a>
      <span class="text-zinc-700">|</span>
      <a
        href="mailto:hello@example.com"
        class="text-zinc-500 hover:text-purple-400 transition-colors text-sm"
      >
        Email
      </a>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("profile-modal");
  const backdrop = document.getElementById("profile-backdrop");
  const closeBtn = document.getElementById("profile-close");
  const openBtn = document.getElementById("profile-open");

  function openModal() {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  openBtn?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>
